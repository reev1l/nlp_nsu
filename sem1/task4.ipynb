      "source": [
        "import re\n",
        "\n",
        "text = 'Предмет обезоружен. Он стручок. Вооружена только куча.'\n",
        "words = re.findall(r'[а-яА-ЯёЁ]+', text)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 2,
      "metadata": {},
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "[('Предмет', 'обезоружен'), ('обезоружен', 'Он'), ('Он', 'стручок'), ('стручок', 'Вооружена'), ('Вооружена', 'только'), ('только', 'куча')]\n",
            "Количество биграмм: 6\n"
          ]
        }
      ],
      "source": [
        "bigrams = list(zip(words, words[1:]))\n",
        "print(bigrams)\n",
        "print('Количество биграмм:', len(bigrams))"
      ]
    }
  ],
